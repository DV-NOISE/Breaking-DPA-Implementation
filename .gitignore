*.py[cod]
*$py.class

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~
pyrightconfig.json
compile_flags.txt

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db

# Scratch and intermediate outputs
*.tmp
temp_*.csv
temp_*.txt
scratch/

# Compiled binaries and object files
*.exe
*.o
*.obj
*.dll
*.so
*.dylib

# Datasets and large binary trace archives (over 50 GB)
